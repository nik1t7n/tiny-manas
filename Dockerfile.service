FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN pip install --no-cache-dir ".[serving]" \
    && useradd --create-home --uid 10001 manas

USER manas

EXPOSE 8000

CMD ["uvicorn", "manas_gpt.service:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--no-server-header"]
